{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.org/schemas/mission_product_manifest.schema.json",
  "title": "TopoAstero mission product manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_key", "stable_star_id", "mission", "segment", "segment_number", "author",
    "product_type", "cadence_class", "cadence_seconds", "exposure_seconds", "flux_column",
    "flux_unit", "uncertainty_column", "uncertainty_unit", "quality_column", "time_column",
    "time_system", "time_unit", "bjd_reference", "time_start", "time_stop", "row_count",
    "finite_flux_rows", "finite_uncertainty_rows", "nonphysical_uncertainty_rows",
    "quality_zero_rows", "duplicate_time_rows", "time_order_violations",
    "missing_cadence_gaps", "crowding_metric", "flux_fraction", "spectral_window_status",
    "unit_status", "aperture_provenance", "mast_obs_id", "mast_obsid", "mast_parent_obsid",
    "mast_product_objid", "product_filename", "data_uri", "size_bytes", "sha256",
    "query_id", "query_date_utc", "acquisition_status", "notes"
  ],
  "properties": {
    "product_key": {"type": "string", "minLength": 1},
    "stable_star_id": {"type": "string", "pattern": "^KIC [0-9]+$"},
    "mission": {"enum": ["Kepler", "TESS"]},
    "segment": {"enum": ["quarter", "sector"]},
    "segment_number": {"type": "integer", "minimum": 0},
    "author": {"enum": ["Kepler", "SPOC", "TESS-SPOC", "QLP"]},
    "product_type": {"const": "pipeline_light_curve"},
    "cadence_class": {"enum": ["short", "long", "target_20s", "target_2min", "ffi"]},
    "cadence_seconds": {"type": "number", "exclusiveMinimum": 0},
    "exposure_seconds": {"type": "number", "exclusiveMinimum": 0},
    "flux_column": {"type": "string", "minLength": 1},
    "flux_unit": {"type": "string", "minLength": 1},
    "uncertainty_column": {"type": "string", "minLength": 1},
    "uncertainty_unit": {"type": "string", "minLength": 1},
    "quality_column": {"type": "string", "minLength": 1},
    "time_column": {"type": "string", "minLength": 1},
    "time_system": {"type": "string", "minLength": 1},
    "time_unit": {"type": "string", "minLength": 1},
    "bjd_reference": {"type": "number"},
    "time_start": {"type": "number"},
    "time_stop": {"type": "number"},
    "row_count": {"type": "integer", "minimum": 1},
    "finite_flux_rows": {"type": "integer", "minimum": 0},
    "finite_uncertainty_rows": {"type": "integer", "minimum": 0},
    "nonphysical_uncertainty_rows": {"type": "integer", "minimum": 0},
    "quality_zero_rows": {"type": "integer", "minimum": 0},
    "duplicate_time_rows": {"type": "integer", "minimum": 0},
    "time_order_violations": {"type": "integer", "minimum": 0},
    "missing_cadence_gaps": {"type": "integer", "minimum": 0},
    "crowding_metric": {"type": ["number", "string"]},
    "flux_fraction": {"type": ["number", "string"]},
    "spectral_window_status": {"type": "string", "minLength": 1},
    "unit_status": {"type": "string", "minLength": 1},
    "aperture_provenance": {"type": "string", "minLength": 1},
    "mast_obs_id": {"type": "string", "minLength": 1},
    "mast_obsid": {"type": "string", "minLength": 1},
    "mast_parent_obsid": {"type": "string", "minLength": 1},
    "mast_product_objid": {"type": "string", "minLength": 1},
    "product_filename": {"type": "string", "minLength": 1},
    "data_uri": {"type": "string", "pattern": "^mast:"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_id": {"type": "string", "minLength": 1},
    "query_date_utc": {"type": "string", "format": "date"},
    "acquisition_status": {"const": "verified_payload_not_redistributed"},
    "notes": {"type": "string", "minLength": 1}
  }
}
