{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.org/schemas/stage5_run_manifest.schema.json",
  "title": "TopoAstero Stage 5 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "created_at_utc", "software_version", "config_path", "config_sha256", "master_seed", "coefficient_field", "style_id", "population_data_used", "final_holdout_used", "input_stage", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"const": "TA-S05-TDA-R001"},
    "status": {"const": "complete"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "software_version": {"const": "TopoAstero-0.6.0"},
    "config_path": {"const": "configs/stage5_tda.yaml"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "master_seed": {"type": "integer"},
    "coefficient_field": {"const": "F2"},
    "style_id": {"const": "TA-PLOT-1.0"},
    "population_data_used": {"const": false},
    "final_holdout_used": {"const": false},
    "input_stage": {"const": "Stage 4 pilot simulation only"},
    "inputs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/file"}},
    "outputs": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
