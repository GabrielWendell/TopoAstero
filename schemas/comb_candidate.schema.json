{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.org/schemas/comb_candidate.schema.json",
  "title": "Stage 6 comb-spacing candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["alias", "spacing_uHz", "difference_score", "autocorrelation_score", "combined_score", "rank"],
  "properties": {
    "alias": {"enum": ["half", "nominal", "double"]},
    "spacing_uHz": {"type": "number", "exclusiveMinimum": 0},
    "difference_score": {"type": "number", "minimum": 0, "maximum": 1},
    "autocorrelation_score": {"type": "number", "minimum": 0, "maximum": 1},
    "combined_score": {"type": "number", "minimum": 0, "maximum": 1},
    "rank": {"type": "integer", "minimum": 1, "maximum": 3}
  }
}

