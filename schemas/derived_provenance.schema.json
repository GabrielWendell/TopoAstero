{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.org/schemas/derived_provenance.schema.json",
  "title": "TopoAstero derived-row provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["raw_product_ids", "config_sha256", "software_version", "source_row_ids"],
  "properties": {
    "raw_product_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "software_version": {"type": "string", "minLength": 1},
    "source_row_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
