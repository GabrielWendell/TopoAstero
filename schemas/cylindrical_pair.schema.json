{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.local/schemas/cylindrical_pair.schema.json",
  "title": "Localized upper-star cubical persistence pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["representation_id", "pair_id", "dimension", "birth", "death", "persistence", "essential", "birth_vertices", "death_vertices", "birth_location", "death_location"],
  "properties": {
    "representation_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "dimension": {"type": "integer", "minimum": 0, "maximum": 1},
    "birth": {"type": "number"},
    "death": {"type": ["number", "null"]},
    "persistence": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "essential": {"type": "boolean"},
    "birth_vertices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "death_vertices": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}},
    "birth_location": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
    "death_location": {"type": ["array", "null"], "items": {"$ref": "#/$defs/location"}}
  },
  "allOf": [
    {"if": {"properties": {"essential": {"const": true}}}, "then": {"properties": {"death": {"const": null}, "persistence": {"const": null}, "death_vertices": {"const": null}, "death_location": {"const": null}}}},
    {"if": {"properties": {"essential": {"const": false}}}, "then": {"properties": {"death": {"type": "number"}, "persistence": {"type": "number"}, "death_vertices": {"type": "array", "minItems": 2}, "death_location": {"type": "array", "minItems": 2}}}}
  ],
  "$defs": {
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["row", "order", "phase_cycles", "frequency_uHz"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "order": {"type": "integer"},
        "phase_cycles": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "frequency_uHz": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
