{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.local/schemas/stage9_gate.schema.json",
  "title": "Stage 9 scientific gate with independent proof-review hold",
  "type": "object", "additionalProperties": false,
  "required": ["gate", "run_id", "status", "implementation_status", "new_claim", "review_id", "review_status", "review_document_sha256", "prior_stage8_decision", "population_spectra_used", "final_holdout_used", "checks"],
  "properties": {
    "gate": {"const": "G9"}, "run_id": {"const": "TA-S09-MATH-R001"},
    "status": {"enum": ["review_pending", "pass"]}, "implementation_status": {"const": "pass"},
    "new_claim": {"const": "S9-T1"},
    "review_id": {"const": "TA-S09-PROOF-REVIEW-001"},
    "review_status": {"enum": ["pending_external_review", "accepted"]},
    "review_document_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "prior_stage8_decision": {"const": "geometry_only"},
    "population_spectra_used": {"const": false}, "final_holdout_used": {"const": false},
    "checks": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["check", "status"], "properties": {"check": {"type": "string"}, "status": {"enum": ["pass", "pending"]}}}}
  }
}
