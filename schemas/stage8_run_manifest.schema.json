{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoastero.local/schemas/stage8_run_manifest.schema.json",
  "title": "Stage 8 simulation run manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "software_version", "config_path", "config_sha256", "style_id", "coefficient_field", "decision", "population_spectra_used", "final_holdout_used", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"const": "TA-S08-ECHELLE-R001"},
    "status": {"const": "complete"},
    "software_version": {"const": "TopoAstero-0.9.0"},
    "config_path": {"const": "configs/stage8_echelle.yaml"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "style_id": {"const": "TA-PLOT-1.0"},
    "coefficient_field": {"const": "F2"},
    "decision": {"enum": ["retain", "geometry_only"]},
    "population_spectra_used": {"const": false},
    "final_holdout_used": {"const": false},
    "inputs": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/file"}},
    "outputs": {"type": "array", "minItems": 14, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {"file": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {
    "path": {"type": "string", "pattern": "^[^\\\\]+$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }}}
}
